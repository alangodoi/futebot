{
  "name": "futebot",
  "version": "1.0.0",
  "description": "Bot de zueira de futebol para WhatsApp",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "deploy": "bash scripts/deploy.sh",
    "setup:server": "bash scripts/setup-server.sh",
    "sync:session": "bash scripts/sync-session.sh",

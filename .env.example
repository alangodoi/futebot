# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
# Alternativas: gpt-4o (mais caloroso), gpt-5.4-mini (mais novo, exige reinício)
# OPENAI_TEMPERATURE=1.05
# OPENAI_FREQUENCY_PENALTY=0.7
# OPENAI_PRESENCE_PENALTY=0.5

# Bot
BOT_NAME=Futebot
BOT_PHONE=

# Banco de dados (SQLite)
DATABASE_PATH=./data/futebot.db

# Pasta de autenticação do WhatsApp (Baileys)
AUTH_STATE_PATH=./auth_info

# Pasta com figurinhas (.webp) e manifest.json
STICKERS_PATH=./stickers

# Comportamento
MESSAGES_PER_RESPONSE=15
MAX_CONTEXT_MESSAGES=30
LOG_LEVEL=info

# Copa do Mundo — foco automático até esta data (YYYY-MM-DD)
WORLD_CUP_UNTIL=2026-07-20
# WORLD_CUP_FOCUS=false  # desliga o foco na Copa mesmo antes da data
# WORLD_CUP_ALERT_POLL_MS=30000  # intervalo de checagem (alertas + lances ao vivo, ms)
